+static HW *glue (audio_pcm_hw_add_new_, TYPE) (struct audsettings *as)
+{
+    AudioState *s = &glob_audio_state;
+    HW *hw = glue (audio_pcm_hw_add_driver_, TYPE) (as, s->drv, s->drv_opaque);
+#if defined(__APPLE__) && !defined(DAC)
+    /*
+     * A guest recording stream must open even when macOS has no usable
