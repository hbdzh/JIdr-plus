// Jidr app window (Workbench direction, D41).

import "../../../apps/jidr-gui/assets/fonts/Geist-Regular.ttf";
import "../../../apps/jidr-gui/assets/fonts/Geist-Medium.ttf";
import "../../../apps/jidr-gui/assets/fonts/Geist-SemiBold.ttf";
import "../../../apps/jidr-gui/assets/fonts/Geist-Bold.ttf";
import "../../../apps/jidr-gui/assets/fonts/GeistMono-Regular.ttf";
import "../../../apps/jidr-gui/assets/fonts/GeistMono-Medium.ttf";
import "../../../apps/jidr-gui/assets/fonts/GeistMono-SemiBold.ttf";
import "../../../apps/jidr-gui/assets/fonts/NotoKufiArabic.ttf";

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { T, Role, Tone, Toast, IconButton, Button, ButtonKind } from "components/base.slint";
import { TitleBar, TasksDialog } from "shell.slint";
import { DeviceCenter, DeviceInfoDialog, FirstRunEmpty } from "launcher.slint";
import { DeviceSheet } from "device_form.slint";
import { ConfirmDialog } from "forms.slint";
import { Palette } from "palette.slint";
import { DeviceView, WidgetPanel } from "player.slint";
import { BatteryPanel, NetworkPanel, SensorsPanel, MorePanel, GpsPanel } from "widgets/panels.slint";
import { SnapshotsPage, SaveSnapshotDialog, RefuseRestoreDialog } from "snapshots.slint";
import { SetupWindow } from "wizard.slint";
import { SettingsWindow } from "settings.slint";
import { RootUi, RootLayer, RootSheetState, RootStep, RootStepState, RootStepVm, RootLogLine } from "../src/root/root.slint";
export { RootUi, RootSheetState, RootStep, RootStepState, RootStepVm, RootLogLine }
import { DeviceVm, GameVm, JobVm, TabVm, SnapshotVm, DevState, RootKind, FormFactor, JobTone, ConnState, RootChoice, ImageRowVm, OptionVm, DeviceForm, DetectRow, PlanRow, UsageRow, PaletteKind, PaletteItem, LogLine, WidgetsVm, KeyMarker } from "types.slint";

export { Theme, Icons, DeviceVm, JobVm, TabVm, SnapshotVm, DevState, RootKind, FormFactor, JobTone, ConnState, RootChoice, ImageRowVm, OptionVm, DeviceForm, DetectRow, PlanRow, UsageRow, PaletteKind, PaletteItem, LogLine, WidgetsVm, SetupWindow, SettingsWindow, KeyMarker }

export component AppWindow inherits Window {
    in-out property <[DeviceVm]> devices;
    in-out property <[JobVm]> jobs;
    in-out property <[TabVm]> tabs;
    /// -1 = Library; otherwise an index into `tabs`.
    in-out property <int> active-tab: -1;
    in-out property <int> selected: -1;
    /// Index into `devices` of the active tab's device (-1 = Library).
    in-out property <int> active-device: -1;
    in-out property <[SnapshotVm]> snapshots;
    in-out property <[GameVm]> games;
    in-out property <string> games-message;
    in-out property <string> games-note;
    in-out property <bool> sdk-ready: true;
    in-out property <bool> library-loading: false;
    in-out property <string> sdk-label: @tr("Not installed");
    in-out property <ConnState> conn: ConnState.online;
    in-out property <string> conn-text;
    in-out property <bool> tasks-open: false;
    /// Drawn traffic lights (snapshots); the live app uses the native ones.
    in property <bool> draw-lights: true;
    in-out property <string> toast;
    in-out property <bool> toast-error: false;
    // Create / edit sheet.
    in-out property <bool> sheet-open: false;
    in-out property <DeviceForm> form;
    in-out property <int> device-edit-page: 0;
    in-out property <[OptionVm]> profiles;
    in-out property <[ImageRowVm]> images;
    in-out property <string> host-ram: "16 GB";
    in-out property <string> host-cpus: "10";
    // Command palette.
    in-out property <bool> palette-open: false;
    in-out property <[PaletteItem]> palette-items;
    in-out property <string> palette-query;
    // Confirmation dialog.
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-title;
    in-out property <string> confirm-body;
    in-out property <string> confirm-action;
    // Player (active device tab).
    in-out property <image> player-frame;
    in-out property <bool> player-has-frame;
    in-out property <int> player-frame-w;
    in-out property <int> player-frame-h;
    in-out property <bool> player-mock: false;
    in-out property <bool> player-pixel-perfect;
    /// Player fullscreen (⌃⌘F, Esc leaves). Set from Rust, which also
    /// switches the native window; UI-only view state.
    in-out property <bool> player-fullscreen;
    in-out property <float> player-scale: 1.0;
    in-out property <bool> player-recording;
    in-out property <string> player-record-text;
    in-out property <bool> player-panel-open: true;
    in-out property <int> player-panel-tab: 0;
    in-out property <bool> player-clipboard;
    in-out property <bool> player-overlay;
    in-out property <string> player-overlay-text;
    in-out property <bool> drop-hover;
    in-out property <string> drop-title;
    in-out property <string> drop-body;
    in-out property <bool> logcat-open;
    in-out property <[LogLine]> log-lines;
    in-out property <string> log-summary;
    in-out property <int> log-errors;
    in-out property <string> log-last-error;
    in-out property <int> log-level: 1;
    in-out property <string> log-filter;
    in-out property <bool> log-following: true;
    in-out property <WidgetsVm> widgets;
    // Snapshot manager.
    in-out property <bool> snapshots-open;
    in-out property <bool> device-details-open: false;
    in-out property <string> snap-banner;
    in-out property <bool> snap-banner-warning;
    in-out property <bool> snap-can-save: true;
    in-out property <bool> save-open;
    in-out property <string> save-name;
    in-out property <RootKind> save-root-kind;
    in-out property <string> save-root-tag;
    in-out property <string> save-hint;
    in-out property <bool> refuse-open;
    in-out property <string> refuse-name;
    in-out property <string> refuse-snapshot-line;
    in-out property <string> refuse-device-line;
    in-out property <string> refuse-body;
    in-out property <string> refuse-hint;
    in-out property <string> refuse-action;
    in-out property <image> gps-map;
    in-out property <bool> gps-has-map;
    in-out property <float> gps-marker-x: 0.5;
    in-out property <float> gps-marker-y: 0.5;
    in-out property <string> gps-route-path;

    callback select-device(int);
    callback open-device(int);
    callback game-device(int);
    callback start-device(int);
    callback stop-device(int);
    callback restart-device(int);
    callback delete-device(int);
    callback edit-device(int);
    callback new-device();
    callback open-palette();
    callback open-settings();
    callback cancel-job(int);
    callback setup-sdk();
    callback use-existing-sdk();
    callback drag-window();
    callback verify-root(int);
    callback revert-root(int);
    callback manage-snapshots(int);
    callback install-apk(int);
    callback screenshots-folder();
    callback send-file(int);
    callback center-screenshot(int);
    callback center-record(int);
    in-out property <bool> center-recording: false;
    callback refresh-games();
    callback launch-game(string);
    callback restore-snapshot(int, int);
    callback submit-form(DeviceForm);
    callback cancel-form();
    callback form-image-changed(int);
    callback form-cold-start();
    callback form-profile-changed(int);
    callback form-manage-snapshots();
    callback palette-query-changed(string);
    callback palette-run(PaletteItem);
    /// ⌘1…9 and other shortcuts Rust handles.
    callback shortcut(string);
    callback confirm-ok();
    callback player-pointer(int, float, float, bool, bool);
    callback player-wheel(length, length);
    callback player-key(string, bool);
    callback player-tool(string);
    callback player-start();
    callback player-resized(length, length);
    callback log-level-changed(int);
    callback log-filter-changed(string);
    callback log-clear();
    callback log-toggle-follow();
    callback log-open(bool);
    /// A widget control changed: (action id, value).
    callback widget-action(string, string);
    callback widget-tab(int);
    callback gps-map-click(float, float);
    callback snapshot-save-request();
    callback snapshot-save(string);
    callback snapshot-delete(int);
    callback refuse-act();

    title: "Jidr";
    icon: @image-url("../../../apps/jidr-gui/assets/icons/app-icon-256.png");
    preferred-width: 1085px;
    preferred-height: 714px;
    min-width: Theme.window-launcher-min-width;
    min-height: Theme.window-launcher-min-height;
    background: Theme.surface-base;
    default-font-family: Theme.font-ui;
    default-font-size: Theme.type-body-size;
    forward-focus: keys;

    /// ⌃⌘F toggles player fullscreen. Slint swaps ⌘ and ⌃ on macOS
    /// (⌘ is `control`, ⌃ is `meta`), so the chord is both, either way.
    function fullscreen-key(text: string, control: bool, meta: bool) -> bool {
        if (control && meta && (text == "f" || text == "F") && root.active-tab >= 0) {
            root.shortcut("fullscreen");
            return true;
        }
        return false;
    }

    /// ⌘ shortcuts, shared by the window and the device screen. Slint reports
    /// ⌘ as `modifiers.control` on macOS (its winit backend swaps ⌘ and ⌃ the
    /// way Qt does), and Ctrl is the same shortcut key on Linux and Windows.
    function meta-key(text: string, alt: bool, shift: bool) -> bool {
        if (alt && (text == "i" || text == "I")) { root.shortcut("overlay"); return true; }
        if (alt && text == "0") { root.shortcut("pixel-perfect"); return true; }
        if (shift && (text == "s" || text == "S")) { root.shortcut("screenshot"); return true; }
        if (alt || shift) { return false; }
        if (text == "l") { root.shortcut("logcat"); return true; }
        if (text == "j") { root.shortcut("panel"); return true; }
        if (text == "k") { root.open-palette(); return true; }
        if (text == "n") { root.new-device(); return true; }
        if (text == ",") { root.open-settings(); return true; }
        return false;
    }

    function preferred-open(i: int) {
        if i >= 0 && i < root.devices.length {
            if root.devices[i].state == DevState.running { root.game-device(i); }
            if root.devices[i].state == DevState.stopped || root.devices[i].state == DevState.crashed { root.start-device(i); }
        }
    }
    keys := FocusScope {
        key-pressed(ev) => {
            if (root.fullscreen-key(ev.text, ev.modifiers.control, ev.modifiers.meta)) {
                return accept;
            }
            if (ev.text == Key.Escape && root.player-fullscreen) {
                root.shortcut("exit-fullscreen");
                return accept;
            }
            if (ev.modifiers.control && root.meta-key(ev.text, ev.modifiers.alt, ev.modifiers.shift)) {
                return accept;
            }
            if (ev.text == Key.Escape) {
                root.sheet-open = false;
                root.palette-open = false;
                root.tasks-open = false;
                root.device-details-open = false;
                root.confirm-open = false;
                root.save-open = false;
                root.refuse-open = false;
                RootUi.open = false;
                return accept;
            }
            if (ev.text == Key.Return && root.active-tab < 0 && root.selected >= 0) {
                root.preferred-open(root.selected);
                return accept;
            }
            return reject;
        }
    }

    /// The active device tab is fullscreen: no title bar.
    property <bool> fs: root.player-fullscreen && root.active-tab >= 0;

    titlebar := TitleBar {
        y: 0px;
        visible: !root.fs;
        draw-lights: root.draw-lights;
        sdk-ready: root.sdk-ready && !root.library-loading;
        job-count: root.jobs.length;
        conn: root.conn;
        conn-text: root.conn-text;
        drag-window => { root.drag-window(); }
        search => { root.open-palette(); }
        new-device => { root.new-device(); }
        settings => { root.open-settings(); }
        tasks => { root.tasks-open = true; }
    }
    body := Rectangle {
        y: root.fs ? 0px : titlebar.height;
        height: root.height - self.y;
        property <bool> library: root.active-tab < 0;
        main := Rectangle {
            width: parent.width;
            height: parent.height;
            if library && root.devices.length == 0 && root.library-loading: T {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 24px;
                text: @tr("Connecting and loading devices…");
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
            if library && root.devices.length == 0 && !root.library-loading: FirstRunEmpty {
                sdk-ready: root.sdk-ready;
                sdk-label: root.sdk-label;
                setup-sdk => { root.setup-sdk(); }
                use-existing => { root.use-existing-sdk(); }
                new-device => { root.new-device(); }
            }
            if !library && root.active-device >= 0: DeviceView {
                device: root.devices[root.active-device];
                frame: root.player-frame;
                has-frame: root.player-has-frame;
                frame-w: root.player-frame-w > 0 ? root.player-frame-w : root.devices[root.active-device].width-px;
                frame-h: root.player-frame-h > 0 ? root.player-frame-h : root.devices[root.active-device].height-px;
                mock-screen: root.player-mock;
                pixel-perfect <=> root.player-pixel-perfect;
                fullscreen: root.fs;
                scale: root.player-scale;
                recording: root.player-recording;
                record-text: root.player-record-text;
                panel-open <=> root.player-panel-open;
                clipboard-shared: root.player-clipboard;
                overlay: root.player-overlay;
                overlay-text: root.player-overlay-text;
                drop-hover: root.drop-hover;
                drop-title: root.drop-title;
                drop-body: root.drop-body;
                logcat-open <=> root.logcat-open;
                log-lines: root.log-lines;
                log-summary: root.log-summary;
                log-errors: root.log-errors;
                log-last-error: root.log-last-error;
                log-level <=> root.log-level;
                log-filter <=> root.log-filter;
                log-following: root.log-following;
                pointer(k, x, y, alt, shift) => { root.player-pointer(k, x, y, alt, shift); }
                wheel(dx, dy) => { root.player-wheel(dx, dy); }
                key(t, down) => { root.player-key(t, down); }
                tool(t) => { root.player-tool(t); }
                start => { root.player-start(); }
                screen-resized(w, h) => { root.player-resized(w, h); }
                log-level-changed(i) => { root.log-level-changed(i); }
                log-filter-changed(t) => { root.log-filter-changed(t); }
                log-clear => { root.log-clear(); }
                log-toggle-follow => { root.log-toggle-follow(); }
                log-open(o) => { root.log-open(o); }
                meta-key(t, a, sh) => { root.meta-key(t, a, sh); }
                fullscreen-key(t, c, m) => { return root.fullscreen-key(t, c, m); }
                WidgetPanel {
                    tab <=> root.player-panel-tab;
                    tab-changed(i) => { root.widget-tab(i); }
                    if root.player-panel-tab == 0: BatteryPanel {
                        vm: root.widgets;
                        action(a, v) => { root.widget-action(a, v); }
                    }
                    if root.player-panel-tab == 1: GpsPanel {
                        vm: root.widgets;
                        map: root.gps-map;
                        has-map: root.gps-has-map;
                        marker-x: root.gps-marker-x;
                        marker-y: root.gps-marker-y;
                        route-path: root.gps-route-path;
                        action(a, v) => { root.widget-action(a, v); }
                        map-click(x, y) => { root.gps-map-click(x, y); }
                    }
                    if root.player-panel-tab == 2: NetworkPanel {
                        vm: root.widgets;
                        action(a, v) => { root.widget-action(a, v); }
                    }
                    if root.player-panel-tab == 3: SensorsPanel {
                        vm: root.widgets;
                        action(a, v) => { root.widget-action(a, v); }
                    }
                    if root.player-panel-tab == 4: MorePanel {
                        vm: root.widgets;
                        action(a, v) => { root.widget-action(a, v); }
                    }
                }
            }
            if library && root.snapshots-open && root.selected >= 0: SnapshotsPage {
                device: root.devices[root.selected];
                snapshots: root.snapshots;
                banner: root.snap-banner;
                banner-warning: root.snap-banner-warning;
                can-save: root.snap-can-save;
                back => { root.snapshots-open = false; }
                save => { root.snapshot-save-request(); }
                restore(i) => { root.restore-snapshot(root.selected, i); }
                delete(i) => { root.snapshot-delete(i); }
            }
            if library && !root.snapshots-open && root.devices.length > 0 && root.selected >= 0: DeviceCenter {
                devices: root.devices;
                selected: root.selected;
                recording: root.center-recording;
                advanced-open <=> root.device-details-open;
                games: root.games;
                games-message: root.games-message;
                games-note: root.games-note;
                select(i) => { root.select-device(i); }
                game(i) => { root.game-device(i); }
                start(i) => { root.start-device(i); }
                stop(i) => { root.stop-device(i); }
                restart(i) => { root.restart-device(i); }
                delete(i) => { root.delete-device(i); }
                edit(i) => { root.edit-device(i); }
                install-apk(i) => { root.install-apk(i); }
                send-file(i) => { root.send-file(i); }
                screenshot(i) => { root.center-screenshot(i); }
                record(i) => { root.center-record(i); }
                screenshots-folder => { root.screenshots-folder(); }
                refresh-games => { root.refresh-games(); }
                launch-game(package) => { root.launch-game(package); }
                manage-snapshots(i) => { root.manage-snapshots(i); }
            }
        }
    }
    if root.device-details-open && root.selected >= 0 && root.selected < root.devices.length: DeviceInfoDialog {
        y: titlebar.height; height: root.height - titlebar.height;
        device: root.devices[root.selected];
        dismiss => { root.device-details-open = false; keys.focus(); }
        verify-root => { root.verify-root(root.selected); }
        revert-root => { root.revert-root(root.selected); }
    }
    if root.tasks-open: TasksDialog {
        y: titlebar.height;
        height: root.height - titlebar.height;
        jobs: root.jobs;
        cancel(i) => { root.cancel-job(i); }
        dismiss => { root.tasks-open = false; keys.focus(); }
    }
    if root.sheet-open: DeviceSheet {
        y: titlebar.height;
        height: root.height - titlebar.height;
        form: root.form;
        edit-page <=> root.device-edit-page;
        profiles: root.profiles;
        images: root.images;
        device-name: root.form.name;
        host-ram: root.host-ram;
        host-cpus: root.host-cpus;
        submit(f) => { root.submit-form(f); }
        cancel => {
            root.cancel-form();
            keys.focus();
        }
        image-changed(i) => { root.form-image-changed(i); }
        profile-changed(i) => { root.form-profile-changed(i); }
        cold-start => { root.form-cold-start(); }
        manage-snapshots => { root.form-manage-snapshots(); }
    }
    if root.palette-open: Palette {
        y: 0px;
        height: root.height;
        items: root.palette-items;
        query: root.palette-query;
        query-changed(q) => {
            root.palette-query = q;
            root.palette-query-changed(q);
        }
        run(item) => {
            root.palette-open = false;
            keys.focus();
            root.palette-run(item);
        }
        dismiss => {
            root.palette-open = false;
            keys.focus();
        }
    }
    if root.save-open: SaveSnapshotDialog {
        y: titlebar.height;
        height: root.height - titlebar.height;
        name: root.save-name;
        device-name: root.selected >= 0 ? root.devices[root.selected].name : "";
        root-kind: root.save-root-kind;
        root-tag: root.save-root-tag;
        sizes-hint: root.save-hint;
        save(n) => {
            root.save-open = false;
            keys.focus();
            root.snapshot-save(n);
        }
        cancel => {
            root.save-open = false;
            keys.focus();
        }
    }
    if root.refuse-open: RefuseRestoreDialog {
        y: titlebar.height;
        height: root.height - titlebar.height;
        snapshot-name: root.refuse-name;
        snapshot-line: root.refuse-snapshot-line;
        device-line: root.refuse-device-line;
        body: root.refuse-body;
        hint: root.refuse-hint;
        action: root.refuse-action;
        act => {
            root.refuse-open = false;
            keys.focus();
            root.refuse-act();
        }
        cancel => {
            root.refuse-open = false;
            keys.focus();
        }
    }
    if root.confirm-open: ConfirmDialog {
        y: titlebar.height;
        height: root.height - titlebar.height;
        title: root.confirm-title;
        body: root.confirm-body;
        action: root.confirm-action;
        ok => {
            root.confirm-open = false;
            keys.focus();
            root.confirm-ok();
        }
        cancel => {
            root.confirm-open = false;
            keys.focus();
        }
    }
    if RootUi.open: RootLayer {
        y: titlebar.height;
        height: root.height - titlebar.height;
    }
    if root.toast != "": Toast {
        y: root.height - 64px;
        text: root.toast;
        tone: root.toast-error ? Tone.negative : Tone.positive;
    }
}

// A separate, device-bound game window. Screen and input use the same
// aspect-preserving rectangle, so letterboxing never changes touch mapping.
export component GameWindow inherits Window {
    in-out property <image> frame;
    in-out property <bool> has-frame;
    in-out property <bool> game-fullscreen;
    in-out property <bool> sidebar-visible: true;
    in-out property <int> frame-w: 1080;
    in-out property <int> frame-h: 2400;
    in-out property <string> device-name;
    in-out property <string> notice;
    in-out property <bool> notice-error: false;
    in-out property <bool> drop-hover;
    in-out property <string> drop-title;
    in-out property <string> drop-status;
    in-out property <bool> drop-busy;
    in-out property <bool> performance-panel;
    in-out property <string> performance-text;
    in-out property <string> performance-memory: @tr("Device memory: waiting for sample");
    in-out property <int> quality: 1;
    in-out property <bool> shortcut-panel;
    in-out property <int> shortcut-capture: -1;
    in-out property <string> shortcut-screenshot;
    in-out property <string> shortcut-fullscreen;
    in-out property <string> shortcut-sidebar;
    in-out property <string> shortcut-performance;
    in-out property <string> shortcut-text;
    in-out property <bool> text-panel;
    in-out property <string> composed-text;
    in-out property <bool> text-sending;
    in-out property <bool> window-panel;
    in-out property <bool> window-pinned;
    in-out property <int> frame-quarter;
    in-out property <bool> mapping-panel;
    in-out property <bool> mapping-edit;
    in-out property <bool> mapping-enabled;
    in-out property <bool> mapping-hints: true;
    in-out property <bool> mapping-pending;
    in-out property <float> pending-x;
    in-out property <float> pending-y;
    in-out property <[KeyMarker]> mapping-markers;
    callback pointer(int, float, float, bool, bool);
    callback wheel(length, length);
    callback key(string, bool);
    callback edit-shortcut(string, bool);
    callback paste-text();
    callback tool(string);
    callback screen-resized(length, length);
    callback drag-window();
    callback sidebar-changed(bool);
    callback map-action(string);
    callback map-place(float, float);
    callback map-remove(float, float, float, float);
    callback map-key(string);
    callback mapped-key(string, bool) -> bool;
    callback map-rotation-changed();
    callback send-text(string);
    callback window-action(string);
    callback quality-changed(int);
    callback command-shortcut(string, bool, bool, bool, bool) -> bool;
    callback inline-text(string);

    title: device-name + " — Jidr";
    preferred-width: 420px;
    preferred-height: 800px;
    min-width: 180px;
    min-height: 240px;
    background: #111318;
    property <length> header-height: root.game-fullscreen ? 0px : 32px;

    Rectangle {
        x: 0px;
        y: 0px;
        height: root.header-height;
        background: Theme.surface-chrome;
        TouchArea {
            x: 80px;
            width: max(0px, parent.width - 120px);
            pointer-event(ev) => { if (ev.kind == PointerEventKind.down) { root.drag-window(); } }
        }
        T { x: 84px; width: max(0px, parent.width - 128px); text: root.device-name + (root.mapping-enabled ? @tr(" · Mapping enabled") : ""); color: Theme.text-secondary; }
        IconButton {
            x: parent.width - 40px;
            icon: Icons.panel-right;
            on: root.sidebar-visible;
            clicked => { root.sidebar-visible = !root.sidebar-visible; root.sidebar-changed(root.sidebar-visible); }
        }
    }

    stage := Rectangle {
        x: 0px;
        y: root.header-height;
        width: parent.width - (root.sidebar-visible ? 48px : 0px);
        height: parent.height - root.header-height;
        background: #000000;
        clip: true;
        property <float> aspect: root.frame-w > 0 && root.frame-h > 0 ? root.frame-w / root.frame-h : 0.45;
        property <length> screen-h: min(self.height, self.width / self.aspect);
        property <length> screen-w: self.screen-h * self.aspect;
        property <length> input-x: 0px;
        property <length> input-y: 0px;
        changed screen-w => { root.screen-resized(self.screen-w, self.screen-h); }
        changed screen-h => { root.screen-resized(self.screen-w, self.screen-h); }
        init => { root.screen-resized(self.screen-w, self.screen-h); }
        screen := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: stage.screen-w;
            height: stage.screen-h;
            background: #000000;
            if root.has-frame: Image { width: parent.width; height: parent.height; source: root.frame; image-fit: fill; image-rendering: smooth; }
            touch := TouchArea {
                pointer-event(ev) => {
                    if (root.mapping-edit && ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                        root.map-remove(self.mouse-x / self.width, self.mouse-y / self.height, self.width / 1px, self.height / 1px);
                        return;
                    }
                    if (ev.button != PointerEventButton.left && ev.button != PointerEventButton.other) { return; }
                    if (ev.kind == PointerEventKind.down) {
                        if (root.mapping-edit || root.mapping-enabled || root.text-panel) { keys.focus(); }
                        else {
                            stage.input-x = screen.x + self.mouse-x;
                            stage.input-y = screen.y + self.mouse-y;
                            inline-input.focus();
                        }
                        if (root.mapping-edit) {
                            root.map-place(self.mouse-x / self.width, self.mouse-y / self.height);
                            return;
                        }
                        root.pointer(0, self.mouse-x / self.width, self.mouse-y / self.height, ev.modifiers.alt, ev.modifiers.shift);
                    } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                        if (root.mapping-edit) { return; }
                        root.pointer(2, self.mouse-x / self.width, self.mouse-y / self.height, ev.modifiers.alt, ev.modifiers.shift);
                    }
                }
                moved => { if (self.pressed && !root.mapping-edit) { root.pointer(1, self.mouse-x / self.width, self.mouse-y / self.height, false, false); } }
                scroll-event(ev) => { root.wheel(ev.delta-x, ev.delta-y); return accept; }
            }
            for marker in root.mapping-markers: Rectangle {
                visible: root.mapping-edit || (root.mapping-enabled && root.mapping-hints);
                x: clamp(parent.width * marker.x - 15px, 0px, max(0px, parent.width - 30px));
                y: clamp(parent.height * marker.y - 15px, 0px, max(0px, parent.height - 30px));
                width: 30px; height: 30px; border-radius: 15px;
                background: #172b4bcc; border-width: 1px; border-color: #8ab4ff;
                T { text: marker.label; color: #ffffff; font-size: 11px; horizontal-alignment: center; }
            }
            if root.mapping-edit && root.mapping-pending: Rectangle {
                x: clamp(parent.width * root.pending-x - 15px, 0px, max(0px, parent.width - 30px));
                y: clamp(parent.height * root.pending-y - 15px, 0px, max(0px, parent.height - 30px));
                width: 30px; height: 30px; border-radius: 15px;
                background: #e5a62bda; border-width: 1px; border-color: #ffffff;
                T { text: "?"; color: #ffffff; horizontal-alignment: center; }
            }
        }
        // A real text input gives macOS an IME context and candidate anchor.
        // Hardware keys still go directly to Android; only committed IME text
        // is sent through the text callback.
        inline-input := TextInput {
            x: stage.input-x; y: stage.input-y; width: 1px; height: 1px;
            color: transparent; selection-background-color: transparent;
            enabled: !root.mapping-enabled && !root.mapping-edit && !root.text-panel;
            key-pressed(ev) => {
                if (root.command-shortcut(ev.text, ev.modifiers.control, ev.modifiers.meta, ev.modifiers.shift, ev.modifiers.alt)) { return accept; }
                if (ev.text == Key.Escape && root.game-fullscreen) { root.tool("exit-fullscreen"); return accept; }
                if (ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt) {
                    if ((!ev.modifiers.shift && (ev.text == "a" || ev.text == "A" || ev.text == "c" || ev.text == "C" || ev.text == "v" || ev.text == "V" || ev.text == "x" || ev.text == "X" || ev.text == "y" || ev.text == "Y")) || ev.text == "z" || ev.text == "Z") {
                        root.edit-shortcut(ev.text, ev.modifiers.shift); return accept;
                    }
                    return reject;
                }
                if (!ev.modifiers.control && !ev.modifiers.meta) { root.key(ev.text, true); }
                return accept;
            }
            key-released(ev) => {
                if (!ev.modifiers.control && !ev.modifiers.meta) { root.key(ev.text, false); }
                return accept;
            }
            edited => { if (self.text != "") { root.inline-text(self.text); self.text = ""; } }
        }
        if inline-input.preedit-text != "": Rectangle {
            x: clamp(stage.input-x, 0px, max(0px, stage.width - self.width));
            y: clamp(stage.input-y - 32px, 0px, max(0px, stage.height - self.height));
            width: min(200px, stage.width); height: 28px;
            border-radius: 5px; background: #202632ed;
            T { x: 8px; width: parent.width - 16px; text: inline-input.preedit-text; color: #ffffff; font-size: 12px; }
        }
        keys := FocusScope {
            width: 0px; height: 0px;
            key-pressed(ev) => {
                if (root.shortcut-capture >= 0 && root.command-shortcut(ev.text, ev.modifiers.control, ev.modifiers.meta, ev.modifiers.shift, ev.modifiers.alt)) { return accept; }
                // Until the text field receives focus, do not leak typing or
                // shortcuts into the Android screen behind the panel.
                if (root.text-panel) { return accept; }
                if (root.mapping-edit) {
                    if (ev.modifiers.control || ev.modifiers.meta || ev.modifiers.alt) { return reject; }
                    root.map-key(ev.text);
                    return accept;
                }
                if (root.command-shortcut(ev.text, ev.modifiers.control, ev.modifiers.meta, ev.modifiers.shift, ev.modifiers.alt)) { return accept; }
                if (ev.text == Key.Escape && root.game-fullscreen) {
                    root.tool("exit-fullscreen");
                    return accept;
                }
                if (ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt) {
                    if ((!ev.modifiers.shift && (ev.text == "a" || ev.text == "A" || ev.text == "c" || ev.text == "C" || ev.text == "v" || ev.text == "V" || ev.text == "x" || ev.text == "X" || ev.text == "y" || ev.text == "Y")) || ev.text == "z" || ev.text == "Z") {
                        root.edit-shortcut(ev.text, ev.modifiers.shift);
                        return accept;
                    }
                    return reject;
                }
                if (!ev.modifiers.control && !ev.modifiers.meta && !ev.modifiers.alt && !ev.modifiers.shift && root.mapping-enabled && root.mapped-key(ev.text, true)) { return accept; }
                if (!ev.modifiers.control && !ev.modifiers.meta) { root.key(ev.text, true); }
                return accept;
            }
            key-released(ev) => {
                if (root.mapping-edit) { return accept; }
                if (root.mapped-key(ev.text, false)) { return accept; }
                if (!ev.modifiers.control && !ev.modifiers.meta) { root.key(ev.text, false); }
                return accept;
            }
        }
    }
    Rectangle {
        visible: root.sidebar-visible;
        x: parent.width - 48px;
        y: root.header-height;
        width: 48px;
        height: parent.height - root.header-height;
        background: Theme.surface-chrome;
        clip: true;
        Flickable {
          x: 0px;
          y: root.game-fullscreen ? 32px : 0px;
          height: parent.height - self.y;
          content-height: max(self.height, 484px);
          VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 484px;
            padding: 4px;
            spacing: 2px;
            alignment: start;
            for t in [
                { id: "back", icon: Icons.arrow-left },
                { id: "home", icon: Icons.circle },
                { id: "recents", icon: Icons.square },
                { id: "volume-up", icon: Icons.volume-2 },
                { id: "volume-down", icon: Icons.volume-1 },
                { id: "rotate-left", icon: Icons.rotate-ccw },
                { id: "rotate-right", icon: Icons.rotate-cw },
                { id: "mapping", icon: Icons.keyboard },
                { id: "text", icon: Icons.message-square },
                { id: "window-settings", icon: Icons.settings },
                { id: "performance", icon: Icons.gauge },
                { id: "shortcuts", icon: Icons.circle-help },
                { id: "screenshot", icon: Icons.camera },
                { id: "fullscreen", icon: Icons.maximize-2 },
            ]: IconButton {
                icon: t.icon;
                on: (t.id == "mapping" && root.mapping-panel) || (t.id == "text" && root.text-panel) || (t.id == "window-settings" && root.window-panel) || (t.id == "performance" && root.performance-panel) || (t.id == "shortcuts" && root.shortcut-panel);
                clicked => {
                    if (t.id == "mapping") { root.mapping-panel = !root.mapping-panel; root.text-panel = false; root.window-panel = false; root.performance-panel = false; root.shortcut-panel = false; root.shortcut-capture = -1; }
                    else if (t.id == "text") { if (!root.mapping-edit) { root.text-panel = !root.text-panel; root.mapping-panel = false; root.window-panel = false; root.performance-panel = false; root.shortcut-panel = false; root.shortcut-capture = -1; } }
                    else if (t.id == "window-settings") { root.window-panel = !root.window-panel; root.mapping-panel = false; root.text-panel = false; root.performance-panel = false; root.shortcut-panel = false; root.shortcut-capture = -1; }
                    else if (t.id == "performance") { root.performance-panel = !root.performance-panel; root.mapping-panel = false; root.text-panel = false; root.window-panel = false; root.shortcut-panel = false; root.shortcut-capture = -1; }
                    else if (t.id == "shortcuts") { root.shortcut-panel = !root.shortcut-panel; root.mapping-panel = false; root.text-panel = false; root.window-panel = false; root.performance-panel = false; root.shortcut-capture = -1; }
                    else { root.tool(t.id); }
                }
            }
          }
        }
    }
    if root.mapping-panel: Rectangle {
        x: 6px;
        y: root.header-height + 6px;
        width: min(312px, stage.width - 12px);
        height: root.mapping-edit ? 110px : 75px;
        border-radius: 8px;
        background: #202632f2;
        clip: true;
        TouchArea { }
        T { x: 8px; y: 4px; width: parent.width - 16px; height: 24px; text: root.mapping-edit ? (root.mapping-pending ? @tr("Press a letter, number, or Space") : @tr("Click a position, then press a key")) : @tr("Device key mapping"); color: #ffffff; font-size: 11px; }
        HorizontalLayout {
            x: 6px; y: 30px; width: parent.width - 12px; height: 30px; spacing: 4px;
            if !root.mapping-edit: Button { small: true; text: @tr("Edit"); clicked => { root.map-action("edit"); } }
            if !root.mapping-edit: Button { small: true; text: root.mapping-enabled ? @tr("Disable") : @tr("Enable"); clicked => { root.map-action("toggle"); } }
            if !root.mapping-edit: Button { small: true; text: root.mapping-hints ? @tr("Hide hints") : @tr("Show hints"); clicked => { root.map-action("hints"); } }
            if root.mapping-edit: Button { small: true; text: @tr("Save"); kind: ButtonKind.primary; clicked => { root.map-action("save"); } }
            if root.mapping-edit: Button { small: true; text: @tr("Clear"); clicked => { root.map-action("clear"); } }
            if root.mapping-edit: Button { small: true; text: @tr("Cancel"); clicked => { root.map-action("cancel"); } }
        }
        if root.mapping-edit: T { x: 8px; y: 66px; width: parent.width - 16px; height: 36px; text: @tr("Rebind to move a key; right-click to delete."); color: #ffffff; font-size: 10px; }
    }
    if root.mapping-edit && !root.mapping-panel: Rectangle {
        x: 6px; y: parent.height - 30px; width: min(250px, stage.width - 12px); height: 24px; border-radius: 5px; background: #202632e8;
        T { x: 6px; width: parent.width - 12px; text: @tr("Editing mappings · open keyboard icon to save"); color: #ffffff; font-size: 10px; }
    }
    if root.mapping-enabled && root.game-fullscreen: Rectangle {
        x: 6px; y: parent.height - 30px; width: 72px; height: 24px; border-radius: 5px; background: #202632e8;
        T { text: @tr("Mapping enabled"); color: #ffffff; font-size: 10px; horizontal-alignment: center; }
    }
    if root.window-panel: Rectangle {
        x: 6px; y: root.header-height + 6px; width: min(312px, stage.width - 12px); height: 82px;
        border-radius: 8px; background: #202632f2; clip: true;
        TouchArea { }
        T { x: 8px; y: 4px; width: parent.width - 16px; height: 24px; text: @tr("Window settings"); color: #ffffff; font-size: 11px; }
        HorizontalLayout {
            x: 6px; y: 34px; width: parent.width - 12px; height: 30px; spacing: 4px;
            Button { small: true; text: @tr("Small"); clicked => { root.window-action("small"); } }
            Button { small: true; text: @tr("Medium"); clicked => { root.window-action("medium"); } }
            Button { small: true; text: @tr("Large"); clicked => { root.window-action("large"); } }
            Button { small: true; text: root.window-pinned ? @tr("Unpin") : @tr("Always on top"); clicked => { root.window-action("pin"); } }
        }
    }
    if root.text-panel: Rectangle {
        x: 6px; y: root.header-height + 6px; width: min(312px, stage.width - 12px); height: 112px;
        border-radius: 8px; background: #202632f2; clip: true;
        TouchArea { }
        T { x: 8px; y: 4px; width: parent.width - 16px; height: 22px; text: @tr("Select an Android text field first; sending uses the Android clipboard"); color: #ffffff; font-size: 10px; }
        Rectangle {
            x: 8px; y: 28px; width: parent.width - 16px; height: 30px; border-radius: 5px; background: #ffffff;
            compose := TextInput {
                x: 6px; width: parent.width - 12px; text <=> root.composed-text;
                enabled: !root.text-sending; color: #111111; font-size: 13px; vertical-alignment: center;
                key-pressed(ev) => {
                    if (root.command-shortcut(ev.text, ev.modifiers.control, ev.modifiers.meta, ev.modifiers.shift, ev.modifiers.alt)) { return accept; }
                    return reject;
                }
            }
            init => { compose.focus(); }
        }
        HorizontalLayout {
            x: 8px; y: 66px; width: parent.width - 16px; height: 30px; spacing: 6px;
            Button { small: true; kind: ButtonKind.primary; text: root.text-sending ? @tr("Sending…") : @tr("Send text"); enabled: !root.text-sending && root.composed-text != ""; clicked => { root.send-text(root.composed-text); } }
            Button { small: true; text: @tr("Paste"); enabled: !root.text-sending; clicked => { root.paste-text(); } }
            Button { small: true; text: @tr("Close"); enabled: !root.text-sending; clicked => { root.text-panel = false; root.composed-text = ""; } }
        }
    }
    if root.performance-panel: Rectangle {
        x: 6px; y: root.header-height + 6px; width: min(312px, stage.width - 12px); height: 144px;
        border-radius: 8px; background: #202632f2; clip: true;
        TouchArea { }
        T { x: 8px; y: 3px; width: parent.width - 16px; height: 24px; text: @tr("Performance and quality"); color: #ffffff; font-size: 11px; }
        T { x: 8px; y: 27px; width: parent.width - 16px; height: 42px; text: root.performance-text; color: #ffffff; font-size: 10px; wrap: word-wrap; }
        T { x: 8px; y: 69px; width: parent.width - 16px; height: 22px; text: root.performance-memory; color: #ffffff; font-size: 10px; }
        HorizontalLayout {
            x: 6px; y: 99px; width: parent.width - 12px; height: 30px; spacing: 4px;
            Button { small: true; text: root.quality == 0 ? @tr("✓ Smooth") : @tr("Smooth"); clicked => { root.quality-changed(0); } }
            Button { small: true; text: root.quality == 1 ? @tr("✓ Sharp") : @tr("Sharp"); clicked => { root.quality-changed(1); } }
            Button { small: true; text: root.quality == 2 ? @tr("✓ Economy") : @tr("Economy"); clicked => { root.quality-changed(2); } }
        }
    }
    if root.shortcut-panel: Rectangle {
        x: 6px; y: root.header-height + 6px; width: min(312px, stage.width - 12px); height: 226px;
        border-radius: 8px; background: #202632f2; clip: true;
        TouchArea { }
        T { x: 8px; y: 4px; width: parent.width - 16px; height: 22px; text: root.shortcut-capture >= 0 ? @tr("Press a new shortcut, Esc to cancel") : @tr("Shortcuts (click to edit)"); color: #ffffff; font-size: 11px; }
        VerticalLayout {
            x: 6px; y: 30px; width: parent.width - 12px; height: 184px; spacing: 4px;
            for entry[i] in [
                { label: @tr("Screenshot"), key: root.shortcut-screenshot },
                { label: @tr("Fullscreen"), key: root.shortcut-fullscreen },
                { label: @tr("Sidebar"), key: root.shortcut-sidebar },
                { label: @tr("Performance panel"), key: root.shortcut-performance },
                { label: @tr("Text panel"), key: root.shortcut-text },
            ]: Button { small: true; text: entry.label + "  " + entry.key; clicked => { root.shortcut-capture = i; keys.focus(); } }
        }
    }
    if root.drop-hover: Rectangle {
        x: 6px; y: root.header-height + 6px; width: max(0px, stage.width - 12px); height: max(0px, stage.height - 12px);
        border-width: 2px; border-color: #78a3ff; border-radius: 8px; background: #17243edc;
        T { x: 8px; y: parent.height / 2 - 20px; width: parent.width - 16px; height: 40px; text: root.drop-title; color: #ffffff; horizontal-alignment: center; wrap: word-wrap; }
    }
    if root.drop-status != "": Rectangle {
        x: 8px; y: root.header-height + 6px; width: min(312px, stage.width - 16px); height: 30px; border-radius: 6px; background: #202632ed;
        T { x: 8px; width: parent.width - 16px; text: root.drop-status; color: #ffffff; font-size: 11px; }
    }
    // The native fullscreen view has no title bar, so keep the toggle
    // available above the screen even while the toolbar is hidden.
    if root.game-fullscreen: Rectangle {
        x: parent.width - 40px;
        y: 0px;
        width: 40px;
        height: 32px;
        background: Theme.surface-chrome;
        IconButton {
            icon: Icons.panel-right;
            on: root.sidebar-visible;
            clicked => { root.sidebar-visible = !root.sidebar-visible; root.sidebar-changed(root.sidebar-visible); }
        }
    }
    if root.notice != "": Rectangle {
        x: 8px;
        y: parent.height - (root.notice-error ? 70px : 48px);
        width: parent.width - 16px;
        height: root.notice-error ? 58px : 36px;
        border-radius: 6px;
        background: root.notice-error ? #8c2935ee : #252830ee;
        T { x: 10px; width: parent.width - 20px; height: parent.height; text: root.notice; color: #ffffff; font-size: 12px; wrap: word-wrap; }
    }
}
